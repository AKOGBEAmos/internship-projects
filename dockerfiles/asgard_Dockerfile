FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN \
  sed -i 's/# \(.*multiverse$\)/\1/g' /etc/apt/sources.list && \
  apt-get update && \
  apt-get -y upgrade && \
  apt-get install -y \
  build-essential \ 
  net-tools \
  iputils-ping \
  traceroute \
  curl \
  wget \
  dnsutils \
  iproute2 \
  tcpdump \
  nano \
  vim \
  less \
  sudo \
  lsof \
  gnupg && \
  apt-get install -y software-properties-common && \
  apt-get install -y byobu curl git htop man unzip vim wget && \
  rm -rf /var/lib/apt/lists/*

# RUN apt install -y iptables apache2 expect netcat-traditional vsftpd openssh-server

RUN apt clean && rm -rf /var/lib/apt/lists/*

EXPOSE 80 21 443

CMD ["/bin/bash"]
 
