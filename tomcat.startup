ifconfig eth0 192.168.250.2 netmask 255.255.255.252 up

echo -e " +++ updating repos  "
chmod 1777 /tmp
apt-get update --allow-unauthenticated

echo -e " +++ installing iptables  "
apt install -y iproute2 nano iptables

# Configuration des routes
ip route add 192.168.2.0/24 via 192.168.250.1 dev eth0
ip route add 192.168.250.4/30 via 192.168.250.1 dev eth0

# Configuration DNS
echo "nameserver 8.8.8.8" | tee /etc/resolv.conf
sed -i '3c\127.0.0.1  tomcat' /etc/hosts

echo " +++ Creating a secondary user +++ "
useradd -m -p k@thara adm1n -s /bin/bash

chown root:root /tmp/root.txt

cp -r /tmp/root.txt /root/root.txt

echo -e " +++ [+] installing and configuring ssh  "
apt-get install openssh-client -y
service ssh start

echo -e " +++ installing netcat "
apt-get install netcat-traditional -y

chmod +x bin/*.sh
./bin/catalina.sh start

#autoriser le traffic vers le serveur
iptables -F
iptables -A INPUT -p tcp --dport 22 -j ACCEPT
iptables -A INPUT -p tcp --dport 80 -j ACCEPT
iptables -A INPUT -p tcp --dport 443 -j ACCEPT
iptables -A INPUT -p tcp --dport 53 -j ACCEPT

iptables -A INPUT -m state --state RELATED,ESTABLISHED -j ACCEPT

echo "[+] Cleaning up"
rm -rf /root/.cache
rm -rf /root/.viminfo

rm -rf /home/adm1n/.cache
rm -rf /home/adm1n/.viminfo
